# VSCode file settings
.vscode/settings.json
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/tasks.json

# Input elf and rom files
*.elf
*.z64

# Local Ocarina of Time decomp checkout, which patches_oot builds against.
# Deliberately not vendored as a submodule: the OoT patches include generated
# headers from its build/ and extracted/ directories, so it has to be a decomp
# that has actually been built, which is gigabytes of artifacts rather than
# something a clone can provide. See OOT_DIR in patches_oot/Makefile.
/lib/oot-decomp/

# Output C files
RecompiledFuncs/
RecompiledPatches/
RecompiledFuncsOoT/
RecompiledPatchesOoT/

# Linux build output
build*/
*.o

# Windows build output
*.exe
*.dll
*.lib
*.pdb

