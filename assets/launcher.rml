<rml>
	<head>
		<title>Launcher</title>
		<link type="text/rcss" href="rml.rcss"/>
		<link type="text/rcss" href="recomp.rcss"/>
		<style>
			body
			{
				width: 100%;
				height: 100%;
			}
		</style>
	</head>
	<body>
		<div id="window" data-model="launcher_model">
			<div class="launcher">
				<div class="launcher__vertical-split">
					<div class="launcher__title-quadrant">
						<!-- Ocarina of Time. Clickable only in a build that has OoT
						     support compiled in (RECOMP_OOT); otherwise it keeps the
						     original disabled "Coming Soon" treatment. -->
						<button data-if="oot_available" onclick="select_oot" data-attrif-selected="oot_selected" class="subtitle-title">
							<div><h3>Zelda 64: Recompiled</h3></div>
							<div><h1>Ocarina of Time</h1></div>
						</button>
						<button data-if="!oot_available" class="subtitle-title" disabled>
							<div><h3>Zelda 64: Recompiled</h3></div>
							<div><h1>Ocarina of Time</h1></div>
							<div class="subtitle-title__disclaimer">Coming Soon™</div>
						</button>
					</div>
					<div class="launcher__content-quadrant">
						<!-- Mirror of the menu on the right half. Only one of the two
						     is ever in the tree, so the autofocus on both is fine. -->
						<button data-if="oot_selected &amp;&amp; !rom_valid" onclick="select_rom" class="menu-list-item" autofocus>
							<div class="menu-list-item__bullet">•</div>
							<div class="menu-list-item__label">Select ROM</div>
						</button>
						<button data-if="oot_selected &amp;&amp; rom_valid" onclick="start_game" class="menu-list-item" autofocus>
							<div class="menu-list-item__bullet">•</div>
							<div class="menu-list-item__label">Start game</div>
						</button>
						<button data-if="oot_selected" onclick="open_controls" class="menu-list-item">
							<div class="menu-list-item__bullet">•</div>
							<div class="menu-list-item__label">Setup controls</div>
						</button>
						<button data-if="oot_selected" onclick="open_settings" class="menu-list-item">
							<div class="menu-list-item__bullet">•</div>
							<div class="menu-list-item__label">Settings</div>
						</button>
						<button data-if="oot_selected" onclick="open_mods" class="menu-list-item">
							<div class="menu-list-item__bullet">•</div>
							<div class="menu-list-item__label">Mods</div>
						</button>
						<button data-if="oot_selected" onclick="exit_game" class="menu-list-item">
							<div class="menu-list-item__bullet">•</div>
							<div class="menu-list-item__label">Exit</div>
						</button>
					</div>
				</div>
				<div class="launcher__vertical-split launcher__vertical-split--right">
					<div class="launcher__background-wrapper">
						<svg src="mm-clipped.svg" class="launcher__background-mm" />
					</div>
					<div class="launcher__title-quadrant launcher__title-quadrant--right">
						<button onclick="select_mm" data-attrif-selected="!oot_selected" class="subtitle-title subtitle-title--right">
							<div><h3>Zelda 64: Recompiled</h3></div>
							<div><h1>Majora's Mask</h1></div>
						</button>
					</div>
					<div class="launcher__content-quadrant">
						<button data-if="!oot_selected &amp;&amp; !rom_valid" onclick="select_rom" class="menu-list-item menu-list-item--right" autofocus>
							<div class="menu-list-item__bullet">•</div>
							<div class="menu-list-item__label">Select ROM</div>
						</button>
						<button data-if="!oot_selected &amp;&amp; rom_valid" onclick="start_game" class="menu-list-item menu-list-item--right" autofocus>
							<div class="menu-list-item__bullet">•</div>
							<div class="menu-list-item__label">Start game</div>
						</button>
						<button data-if="!oot_selected" onclick="open_controls" class="menu-list-item menu-list-item--right">
							<div class="menu-list-item__bullet">•</div>
							<div class="menu-list-item__label">Setup controls</div>
						</button>
						<button data-if="!oot_selected" onclick="open_settings" class="menu-list-item menu-list-item--right">
							<div class="menu-list-item__bullet">•</div>
							<div class="menu-list-item__label">Settings</div>
						</button>
						<button data-if="!oot_selected" onclick="open_mods" class="menu-list-item menu-list-item--right">
							<div class="menu-list-item__bullet">•</div>
							<div class="menu-list-item__label">Mods</div>
						</button>
						<button data-if="!oot_selected" onclick="exit_game" class="menu-list-item menu-list-item--right">
							<div class="menu-list-item__bullet">•</div>
							<div class="menu-list-item__label">Exit</div>
						</button>
					</div>
				</div>
				<div class="bottom-left">
					<label>v{{version_number}}</label>
				</div>
			</div>
		</div>
	</body>
</rml>
